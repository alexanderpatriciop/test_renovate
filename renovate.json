{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": [
    "renovate-updates",
    "main"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "extends": [
    ":automergeDisabled",
    ":renovatePrefix",
    ":timezone(America/New_York)",
    "config:recommended",
    "group:symfony",
    "schedule:automergeWeekends"
  ],
  "platformAutomerge": false,
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "composer"
      ],
      "enabled": true
    },
    {
      "matchCurrentValue": "!/^\\^.*/",
      "dependencyDashboardApproval": true,
      "addLabels": [
        "pinned-package"
      ],
      "rangeStrategy": "auto",
      "matchPackageNames": [
        "/^.*/"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "addLabels": [
        "patch/minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "drupal/core",
        "/^drupal/core-.*/"
      ],
      "groupName": "Drupal Core Major",
      "automerge": false,
      "addLabels": [
        "drupal-core"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchPackageNames": [
        "drupal/core",
        "/^drupal/core-.*/"
      ],
      "groupName": "Drupal Core",
      "automerge": true,
      "addLabels": [
        "drupal-core"
      ]
    },
    {
      "groupName": "jQuery packages",
      "addLabels": [
        "jquery"
      ],
      "matchPackageNames": [
        "jquery{/,}**"
      ]
    },
    {
      "matchBaseBranches": [
        "main"
      ],
      "enabled": false,
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": [
        "security-hotfix"
      ]
    }
  ],
  "platform": "github",
  "prConcurrentLimit": 3,
  "rangeStrategy": "bump",
  "rebaseWhen": "auto"
}
